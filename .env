# Version string used for the AppImage filename (e.g. moon-lander-1.0-10-x86_64.AppImage)
# This no longer pins an apt package version — the source is cloned from Salsa.
VERSION=1.0-10

# Docker workspace mount point (must be an absolute path)
WORKSPACE=/workspace

# Set PLATFORM to linux/amd64 or linux/arm64 as needed
PLATFORM=linux/amd64
